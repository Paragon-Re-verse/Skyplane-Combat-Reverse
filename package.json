{
  "name": "skyplane-combat-reverse",
  "version": "1.1.2",
  "private": true,
  "description": "Сборка модуля SkyPlane Combat Re:verse для Foundry VTT",
  "type": "module",
  "scripts": {
    "build:css": "sass styles/skyplane-combat-reverse.scss styles/skyplane-combat-reverse.css --no-source-map --silence-deprecation=color-functions,global-builtin,import",
    "build:packs": "node tools/pack.mjs",
    "unpack": "node tools/unpack.mjs",
    "templates": "node tools/make-templates.mjs",
    "placeholders": "node tools/make-placeholders.mjs",
    "check": "node scripts/rules/ship-rules.check.mjs && node tools/check-i18n.mjs",
    "build": "npm run english && npm run build:css && npm run build:packs && npm run check",
    "package": "npm run build && node tools/package.mjs",
    "english": "node tools/make-english.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.5",
    "sass": "1.105.2"
  }
}
