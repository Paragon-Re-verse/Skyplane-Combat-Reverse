<div class="skyplane-compartment-sheet-body">
  <header class="skyplane-item-header">
    <img src="{{item.img}}" data-action="editImage" data-edit="img" alt="" data-tooltip="{{item.name}}">
    <input type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
  </header>

  <div class="skyplane-form-grid">
    <label>{{sky "compartment.category"}}</label>
    <select name="system.systemCategory">{{selectOptions categories selected=system.systemCategory valueAttr="value" labelAttr="label"}}</select>

    <label>{{sky "itemSheet.size"}}</label>
    <div class="skyplane-pair">
      <input type="number" min="1" max="8" name="system.height" value="{{system.height}}">
      <span>×</span>
      <input type="number" min="1" max="14" name="system.width" value="{{system.width}}">
    </div>

    <label>{{sky "itemSheet.hp"}}</label>
    <input type="number" min="0" name="system.hp" value="{{system.hp}}">

    <label>{{sky "itemSheet.tileImage"}}</label>
    <file-picker name="system.img" type="image" value="{{system.img}}"></file-picker>

    <label>{{sky "compartment.keywords"}}</label>
    <input type="text" name="system.keywords" value="{{keywordsText}}" placeholder="{{sky "itemSheet.keywordsHint"}}">

    <label>{{sky "params.speed"}}</label>
    <input type="number" min="0" name="system.speed" value="{{system.speed}}">

    <label>{{sky "params.fuelEconomy"}}</label>
    <input type="number" min="0" name="system.fuelEconomy" value="{{system.fuelEconomy}}">

    <label>{{sky "systems.effect"}}</label>
    <textarea name="system.effect" rows="3">{{system.effect}}</textarea>

  </div>

  <fieldset class="skyplane-flags skyplane-effects">
    <legend>{{sky "effects.title"}}</legend>
    <p class="skyplane-hint">{{sky "effects.hint"}}</p>
    <ol class="skyplane-effect-list">
      {{#each effects}}
      <li data-effect-id="{{id}}" class="{{#if disabled}}disabled{{/if}}">
        <img src="{{img}}" alt="">
        <span class="name">{{name}}</span>
        <span class="summary">{{summary}}</span>
        {{#if @root.editable}}
        <a data-action="toggleEffect" data-tooltip="{{sky "effects.toggle"}}"><i class="fa-solid {{#if disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></a>
        <a data-action="editEffect" data-tooltip="{{sky "effects.edit"}}"><i class="fa-solid fa-pen"></i></a>
        <a data-action="deleteEffect" data-tooltip="{{sky "effects.delete"}}"><i class="fa-solid fa-trash"></i></a>
        {{else}}
        <a data-action="editEffect" data-tooltip="{{sky "effects.edit"}}"><i class="fa-solid fa-eye"></i></a>
        {{/if}}
      </li>
      {{else}}
      <li class="skyplane-empty">{{sky "effects.empty"}}</li>
      {{/each}}
    </ol>
    {{#if editable}}
    <div class="skyplane-pair">
      <select data-effect-preset>{{selectOptions effectPresets valueAttr="value" labelAttr="label"}}</select>
      <button type="button" class="skyplane-button" data-action="addEffect"><i class="fa-solid fa-plus"></i> {{sky "effects.add"}}</button>
    </div>
    {{/if}}
  </fieldset>

  <fieldset class="skyplane-flags skyplane-combat-fields">
    <legend>{{sky "combat.section"}}</legend>
    <p class="skyplane-hint">{{sky "itemSheet.combatHint"}}</p>
    <div class="skyplane-form-grid">
      <label>{{sky "itemSheet.checkSkill"}}</label>
      <select name="system.checkSkill">{{selectOptions skills selected=system.checkSkill valueAttr="value" labelAttr="label"}}</select>

      <label>{{sky "combat.dc"}}</label>
      <input type="number" min="0" name="system.checkDc" value="{{system.checkDc}}">

      <label>{{sky "combat.ranges"}}</label>
      <div class="skyplane-pair">
        {{#each ranges}}
        <label><input type="checkbox" name="rangeFlags.{{value}}" {{checked checked}}> {{label}}</label>
        {{/each}}
      </div>

      <label>{{sky "combat.special"}}</label>
      <select name="system.special">{{selectOptions specials selected=system.special valueAttr="value" labelAttr="label"}}</select>

      <label>{{sky "systems.firepower"}}</label>
      <div class="skyplane-pair">
        <input type="number" min="0" name="system.damageDice" value="{{system.damageDice}}" data-tooltip="{{sky "itemSheet.damageDice"}}">
        <select name="system.damageDie">{{selectOptions faces selected=system.damageDie valueAttr="value" labelAttr="label"}}</select>
        <span>+</span>
        <input type="number" name="system.damageBonus" value="{{system.damageBonus}}" data-tooltip="{{sky "itemSheet.damageBonus"}}">
      </div>
    </div>
    {{#if specialHint}}<p class="skyplane-hint">{{specialHint}}</p>{{/if}}
  </fieldset>

  <fieldset class="skyplane-flags">
    <legend>{{sky "itemSheet.flags"}}</legend>
    {{#each flags}}
    <label><input type="checkbox" name="system.{{key}}" {{checked checked}}> {{label}}</label>
    {{/each}}
  </fieldset>

  {{#if isGM}}
  <div class="skyplane-sync">
    <button type="button" class="skyplane-button" data-action="syncShips" {{#unless placedCount}}disabled{{/unless}}>
      <i class="fa-solid fa-rotate"></i> {{sky "catalog.sync"}} ({{placedCount}})
    </button>
    <p class="skyplane-hint">{{sky "catalog.syncHint"}}</p>
  </div>
  {{/if}}

  <h3 class="skyplane-heading">{{sky "description.title"}}</h3>
  <prose-mirror name="system.description" value="{{system.description}}" toggled {{#unless editable}}disabled{{/unless}}>
    {{{descriptionHtml}}}
  </prose-mirror>
</div>
